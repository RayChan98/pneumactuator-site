---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
---

<Layout title="About Us | PNEUMACTUATOR Pneumatic Actuator Manufacturer" description="PNEUMACTUATOR is a Wenzhou-based pneumatic actuator factory specializing in rack and pinion, scotch yoke and spring return valve actuators, with ISO 5211 / NAMUR compliance, factory-direct pricing and OEM/ODM support.">
  <!-- Hero -->
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="text-sm font-semibold text-night-green">ABOUT US</p>
      <h1 class="mt-2 max-w-3xl text-3xl font-extrabold tracking-tight sm:text-4xl">A Pneumatic Actuator Factory That Takes Torque Testing Seriously</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300">
        PNEUMACTUATOR builds rack and pinion, scotch yoke, spring return, double acting and linear pneumatic actuators in our own factory in Wenzhou, Zhejiang, China, and ships them factory-direct to valve distributors, automation integrators and process plants worldwide.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight text-navy-950">From Our Factory to Your Valve Line</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            Valve automation fails at the interface: mounting dimensions that do not line up, torque margins that are too thin and accessory pads that force extra brackets. We machine every actuator around ISO 5211 and NAMUR interfaces, so standard ball, butterfly and plug valves pair with our units without adapters, and every output torque rating is verified on a calibrated test bench rather than on a datasheet.
          </p>
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            Today our factory produces AT, AW, SR, DA and LF series actuators spanning 8 Nm to 200,000+ Nm output torque for water treatment, oil &amp; gas, chemical and power applications across global markets. Every unit passes a documented four-gate inspection before it leaves our facility, because an actuator that fails in the field stops a whole process line.
          </p>
          <div class="mt-8 grid grid-cols-3 gap-6 border-t border-slate-200 pt-8">
            <div>
              <p class="text-3xl font-extrabold text-brand-blue">8–200,000 Nm</p>
              <p class="mt-1 text-sm text-slate-600">Output torque range</p>
            </div>
            <div>
              <p class="text-3xl font-extrabold text-brand-blue">ISO 5211</p>
              <p class="mt-1 text-sm text-slate-600">Valve mounting standard</p>
            </div>
            <div>
              <p class="text-3xl font-extrabold text-brand-blue">7–15 days</p>
              <p class="mt-1 text-sm text-slate-600">Standard lead time</p>
            </div>
          </div>
        </div>
        <div class="grid gap-4">
          <div class="overflow-hidden rounded-2xl">
            <video controls playsinline preload="none" class="aspect-video w-full object-cover" poster="/logo/logo-icon.svg">
              <source src="/videos/factory.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
          <div class="overflow-hidden rounded-2xl">
            <video controls playsinline preload="none" class="aspect-video w-full object-cover">
              <source src="/videos/final-inspection.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About 分类卡片（istamping 模式：每类占领长尾词） -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">EXPLORE OUR CAPABILITIES</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-navy-950">Inside the Factory</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          {
            t: 'Factory & Facility',
            d: 'CNC machining, assembly lines and a torque test bench under one roof — dedicated production for AT, AW, SR, DA and LF series actuators.',
            href: '#factory',
            icon: '🏭',
          },
          {
            t: 'Quality Control',
            d: 'Calibrated torque testing, air leak checks and cycle tests, with per-lot inspection reports shared on request.',
            href: '#quality',
            icon: '✅',
          },
          {
            t: 'Technology & Equipment',
            d: 'Rack and pinion geometry, scotch yoke torque profiles and NAMUR accessory integration — engineered and validated in-house.',
            href: '#technology',
            icon: '🔬',
          },
          {
            t: 'Certificates & Compliance',
            d: 'ISO 9001 quality management, CE documentation and ATEX / SIL options for hazardous-area service.',
            href: '#certificates',
            icon: '📜',
          },
          {
            t: 'Production Process',
            d: 'Incoming material QC → CNC machining → torque test & final inspection → documented shipment. Four gates, each one recorded.',
            href: '#process',
            icon: '⚙️',
          },
          {
            t: 'Supply Chain Management',
            d: 'From casting and seal sourcing to consolidated export shipping — one point of contact for your whole order.',
            href: '#supply-chain',
            icon: '🚚',
          },
        ].map((c) => (
          <a href={c.href} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
            <span class="text-3xl">{c.icon}</span>
            <h3 class="mt-4 text-lg font-bold text-navy-950 group-hover:text-brand-blue">{c.t}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{c.d}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-blue">Learn More →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
      <h2 class="text-3xl font-extrabold tracking-tight text-navy-950">Why Buy Factory-Direct from PNEUMACTUATOR?</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Factory-Direct Pricing', 'No trading-company markup. Volume quotes and 7–15 day lead times for distributors and project buyers.'],
          ['Own Factory & Quality Control', 'Machining, assembly and torque testing in our own facility, with documented inspection before every shipment.'],
          ['OEM / ODM Support', 'Custom torque, spring sets, materials, mounting and private label for your product line.'],
          ['Export Experience', 'An experienced team for global B2B buyers — documents, logistics and after-sales support.'],
        ].map(([t, d]) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="font-semibold text-navy-950">{t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 锚点详情区（修复 #technology/#certificates/#process/#supply-chain 死锚点） -->
  <section id="technology" class="scroll-mt-40 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
      <h2 class="text-3xl font-extrabold tracking-tight text-navy-950">R&D and Technology</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-semibold text-navy-950">Precision Rack &amp; Pinion Mechanism</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Twin piston racks drive a precision-machined pinion for balanced 90° torque output. Hard-anodized bodies and sealed bearings keep the mechanism stable through 1,000,000+ cycles of testing.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-semibold text-navy-950">Scotch Yoke Torque Profile</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">The sliding yoke delivers its highest torque at the 0° and 90° end positions, where valve seating and unseating demand the most force, with lower air consumption per cycle on large DN200+ valves.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-semibold text-navy-950">NAMUR &amp; ISO 5211 Integration</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Standardized mounting pads for solenoids, limit switches and positioners, plus ISO 5211 top and bottom interfaces. Accessories bolt on without brackets or adapters.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-semibold text-navy-950">Custom Engineering (ODM)</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">For ODM partners we adjust torque curves, spring pre-load, stroke angles and body materials to match specific valves and markets — a level of control trading companies cannot offer.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="certificates" class="scroll-mt-40 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
      <h2 class="text-3xl font-extrabold tracking-tight text-navy-950">Certificates &amp; Compliance</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-semibold text-navy-950">ISO 9001 Quality Management</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Our machining, assembly and inspection processes run under an ISO 9001-based quality system, with batch records kept for every production run and shipment.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-semibold text-navy-950">CE &amp; ATEX Documentation</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">CE documentation accompanies standard orders; ATEX and SIL versions are available for oil &amp; gas and hazardous-area projects, with certificates provided per unit.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-semibold text-navy-950">Material &amp; Environmental Validation</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Salt-spray and temperature testing on production batches. Standard units cover -20°C to +80°C, with extended ranges from -40°C to +150°C available on request.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="process" class="scroll-mt-40 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
      <h2 class="text-3xl font-extrabold tracking-tight text-navy-950">Production Process</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-3xl font-extrabold text-brand-blue">1</p>
          <h3 class="mt-2 font-semibold text-navy-950">Incoming Material QC</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Castings, aluminum profiles, seals and springs are verified against spec before entering the line — off-spec material is returned before it reaches machining.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-3xl font-extrabold text-brand-blue">2</p>
          <h3 class="mt-2 font-semibold text-navy-950">CNC Machining &amp; Assembly</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Body, piston, rack and pinion parts are machined to tolerance, then assembled with measured fits and air-leak checks at each station.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-3xl font-extrabold text-brand-blue">3</p>
          <h3 class="mt-2 font-semibold text-navy-950">Torque Test &amp; Final Inspection</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Every unit runs on a calibrated torque test bench — output torque, travel angle, air consumption and fail-safe action are recorded on the test sheet.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-3xl font-extrabold text-brand-blue">4</p>
          <h3 class="mt-2 font-semibold text-navy-950">Documented Shipment</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Test sheets, certificates and packing lists accompany every order. Four gates, each one recorded, from material receipt to shipment.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="supply-chain" class="scroll-mt-40 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
      <h2 class="text-3xl font-extrabold tracking-tight text-navy-950">Supply Chain Management</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-semibold text-navy-950">Component Sourcing</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Long-term relationships with casting, extrusion, seal and spring suppliers secure stable quality and allocation — even in tight raw-material markets.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-semibold text-navy-950">Consolidated Shipping</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Actuators, valve packages and accessories ship consolidated to your port or door — one point of contact, one shipment, less freight.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-semibold text-navy-950">After-Sales Support</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Spare parts, RMA service and torque re-verification are coordinated by a dedicated account team — email sales@pneumactuator.com and expect a reply within one business day.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Partner with an Actuator Factory, Not a Middleman"
    subtitle="Request our catalog, torque charts and wholesale price list — replies within 24 hours."
  />
</Layout>
