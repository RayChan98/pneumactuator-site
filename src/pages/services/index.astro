---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';

// Services 索引：气动执行器 3 大服务
const services = [
  {
    title: 'OEM & ODM Actuator Manufacturing',
    desc: 'Build an actuator line under your own brand — private label, custom torque ranges, housing and packaging.',
    href: '/services/oem-odm/',
    kw: 'pneumatic actuator oem',
    icon: '🏭',
  },
  {
    title: 'Quality Assurance & Torque Testing',
    desc: 'Every actuator passes a documented torque bench test before it ships — built for importers who cannot afford field failures.',
    href: '/services/quality-inspection/',
    kw: 'actuator quality inspection',
    icon: '✅',
  },
];
---

<Layout title="Services | PNEUMACTUATOR Pneumatic Actuator Manufacturer" description="OEM ODM actuator manufacturing and torque-tested quality assurance — factory-direct from PNEUMACTUATOR.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-night-green">SERVICES</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight">Factory Services for Valve Distributors</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-300">Private-label manufacturing and torque-tested quality — the two services distributors ask for most.</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="grid gap-6 md:grid-cols-2">
        {services.map((s) => (
          <a href={s.href} class="group rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-blue/10 text-2xl">{s.icon}</span>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-brand-blue">{s.kw}</p>
            <h2 class="mt-2 text-xl font-extrabold text-navy-950 group-hover:text-brand-blue">{s.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{s.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-blue">
              Learn More
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4 transition group-hover:translate-x-1"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Need OEM Support?"
    subtitle="Tell us your target torque range and valve types — we'll quote a private-label program within 24 hours."
  />
</Layout>
